# Production snippet — copy relevant lines into domains/sportifyplus.de/public_html/.env
# Full checklist: docs/google-oauth-hopn.md

APP_URL=https://sportifyplus.de

# Dedicated Sportify OAuth client (HOPn Identity app #4 — do not use AI Pass shared client)
GOOGLE_CLIENT_ID=YOUR_SPORTIFY_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_SPORTIFY_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://sportifyplus.de/auth/google/callback

# Manus AI (HOPn) — set in production .env only; never commit secrets
MANUS_API_KEY=
HOPN_MANUS_API_KEY=
MANUS_BASE_URL=https://api.manus.ai/v2
MANUS_AGENT_PROFILE=manus-1.6-lite
MANUS_POLL_TIMEOUT=45
MANUS_POLL_INTERVAL=2
