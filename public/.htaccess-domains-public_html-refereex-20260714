<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_HOST} ^(www\.)?talents\.sportifyplus\.de$ [NC]
    RewriteRule ^ - [L]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
    RewriteCond %{REQUEST_URI} ^/public/?(.*)$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

    RewriteRule ^only-talents/home/?$ public/ot-canonical-redirect-20260707.php [L,QSA]
    RewriteCond %{REQUEST_URI} ^/only-talents/home/?$ [NC]
    RewriteRule ^ /only-talents [R=301,L,QSA]
    RedirectMatch 301 (?i)^/only-talents/home/?$ /only-talents

    RewriteRule ^(app|config|database|storage|views|bootstrap\.php)(/|$) - [F,L]
    RewriteRule ^lang/(en|de|ar)/messages\.php$ - [F,L]

    # RefereeX AI — static HTML (no PHP / OPcache)
    RewriteRule ^refereex-ai/?$ live-sports.html [L]
    RewriteRule ^refereex-ai\.html$ live-sports.html [L]

    RewriteRule ^$ public/index.php [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.+)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    <Files "live-sports.html">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set X-LiteSpeed-Purge "*"
    </Files>
</IfModule>

Options -Indexes
