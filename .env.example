APP_NAME=Sportify
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_KEY=sportify-dev-key-change-me

DB_CONNECTION=sqlite
DB_DATABASE=

# --- Google OAuth (HOPn Identity — dedicated Sportify client, app #4) ---
# Create a Web OAuth client in Google Cloud Console; see docs/google-oauth-hopn.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sportifyplus.de/auth/google/callback

# --- Manus AI (HOPn) — never commit real keys ---
# Auth header: x-manus-api-key. Async: task.create + task.listMessages.
MANUS_API_KEY=
# Optional alias if you store the same key under the HOPn naming convention:
HOPN_MANUS_API_KEY=
MANUS_BASE_URL=https://api.manus.ai/v2
MANUS_AGENT_PROFILE=manus-1.6-lite
MANUS_POLL_TIMEOUT=45
MANUS_POLL_INTERVAL=2

# Optional OpenAI (chatbot / wellness / player analysis)
OPENAI_API_KEY=

# Facebook / LinkedIn (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_SCOPES=public_profile

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# OnlyTalents subdomain
OT_HOST=talents.sportifyplus.de
OT_URL=https://talents.sportifyplus.de
OT_MAIN_URL=https://sportifyplus.de
SESSION_DOMAIN=.sportifyplus.de

# --- Outbound mail (partner invites) — never commit real passwords ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=partners@sportifyplus.de
MAIL_FROM_NAME="Sportify Plus"
