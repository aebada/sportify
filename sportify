function syncKoooraSeed(PDO $pdo): void
{
    $seedFile = __DIR__ . '/database/seeds/kooora.php';
    if (!is_file($seedFile)) {
        return;
    }
    $seed = \App\Support\Seed::load('kooora');
    $now = date('Y-m-d H:i:s');
    $isSqlite = Database::isSqlite();

    // Teams
    if (tableExists($pdo, 'teams')) {
        foreach ($seed['teams'] ?? [] as $t) {
            $stmt = $pdo->prepare('SELECT id FROM teams WHERE slug = ? LIMIT 1');
            $stmt->execute([$t['slug']]);
            if ($stmt->fetch()) {
                continue;
            }
            $pdo->prepare(
                'INSERT INTO teams (slug, name, short_name, country, stadium, league_slug, logo, data, created_at)
                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)'
            )->execute([
                $t['slug'], $t['name'], $t['short_name'] ?? null, $t['country'] ?? null,
                $t['stadium'] ?? null, $t['league_slug'] ?? null, $t['logo'] ?? null,
                json_encode(['squad' => $t['squad'] ?? []]), $now,
            ]);
            ok('synced team: ' . $t['name']);
        }
    }

    $teamIds = [];
    if (tableExists($pdo, 'teams')) {
        foreach ($pdo->query('SELECT id, name FROM teams')->fetchAll(PDO::FETCH_ASSOC) as $row) {
            $teamIds[$row['name']] = (int) $row['id'];
        }
    }

    // Standings
    if (tableExists($pdo, 'standings')) {
        foreach ($seed['standings'] ?? [] as $s) {
            $stmt = $pdo->prepare(
                'SELECT id FROM standings WHERE competition_slug = ? AND team_name = ? AND split_type = ? LIMIT 1'
            );
            $stmt->execute([$s['competition_slug'], $s['team_name'], $s['split_type'] ?? 'overall']);
            if ($stmt->fetch()) {
                continue;
            }
            $pdo->prepare(
                'INSERT INTO standings (competition_slug, team_id, team_name, split_type, position, played, won, drawn, lost, goals_for, goals_against, goal_diff, points, form, group_name, created_at)
                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
            )->execute([
                $s['competition_slug'], $teamIds[$s['team_name']] ?? null, $s['team_name'],
                $s['split_type'] ?? 'overall', $s['position'], $s['played'], $s['won'], $s['drawn'], $s['lost'],
                $s['goals_for'], $s['goals_against'], $s['goal_diff'], $s['points'], $s['form'] ?? null,
                $s['group_name'] ?? null, $now,
            ]);
        }
        ok('synced standings');
    }

    // Scorers
    if (tableExists($pdo, 'scorers')) {
        foreach ($seed['scorers'] ?? [] as $sc) {
            $stmt = $pdo->prepare(
                'SELECT id FROM scorers WHERE competition_slug = ? AND player_name = ? LIMIT 1'
            );
            $stmt->execute([$sc['competition_slug'], $sc['player_name']]);
            if ($stmt->fetch()) {
                continue;
            }
            $pdo->prepare(
                'INSERT INTO scorers (competition_slug, player_name, team_name, goals, assists, matches, created_at)
                 VALUES (?, ?, ?, ?, ?, ?, ?)'
            )->execute([
                $sc['competition_slug'], $sc['player_name'], $sc['team_name'],
                $sc['goals'], $sc['assists'], $sc['matches'], $now,
            ]);
        }
        ok('synced scorers');
    }

    // Transfer deals
    if (tableExists($pdo, 'transfer_deals')) {
        foreach ($seed['transfers'] ?? [] as $tr) {
            $stmt = $pdo->prepare(
                'SELECT id FROM transfer_deals WHERE player_name = ? AND to_club = ? AND deal_date = ? LIMIT 1'
            );
            $stmt->execute([$tr['player_name'], $tr['to_club'], $tr['deal_date']]);
            if ($stmt->fetch()) {
                continue;
            }
            $pdo->prepare(
                'INSERT INTO transfer_deals (deal_date, player_name, player_slug, from_club, to_club, fee, fee_cents, status, league, deal_type, created_at)
                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
            )->execute([
                $tr['deal_date'], $tr['player_name'], $tr['player_slug'] ?? null,
                $tr['from_club'], $tr['to_club'], $tr['fee'] ?? null, $tr['fee_cents'] ?? 0,
                $tr['status'], $tr['league'] ?? null, $tr['deal_type'] ?? null, $now,
            ]);
        }
        ok('synced transfer deals');
    }

    // Rankings
    if (tableExists($pdo, 'rankings')) {
        foreach ($seed['fifa_rankings'] ?? [] as $r) {
            $stmt = $pdo->prepare('SELECT id FROM rankings WHERE ranking_type = ? AND rank = ? LIMIT 1');
            $stmt->execute(['fifa', $r['rank']]);
            if ($stmt->fetch()) {
                continue;
            }
            $pdo->prepare(
                'INSERT INTO rankings (ranking_type, rank, name, country_code, points, movement, created_at)
                 VALUES (?, ?, ?, ?, ?, ?, ?)'
            )->execute(['fifa', $r['rank'], $r['name'], $r['country_code'], $r['points'], $r['movement'], $now]);
        }
        foreach ($seed['club_rankings'] ?? [] as $r) {
            $stmt = $pdo->prepare('SELECT id FROM rankings WHERE ranking_type = ? AND rank = ? LIMIT 1');
            $stmt->execute(['club', $r['rank']]);
            if ($stmt->fetch()) {
                continue;
            }
            $pdo->prepare(
                'INSERT INTO rankings (ranking_type, rank, name, country_code, points, movement, created_at)
                 VALUES (?, ?, ?, ?, ?, ?, ?)'
            )->execute(['club', $r['rank'], $r['name'], $r['country_code'], $r['points'], $r['movement'], $now]);
        }
        ok('synced rankings');
    }

    // Extra league competition + fixtures
    foreach ($seed['league_fixtures'] ?? [] as $lc) {
        $stmt = $pdo->prepare('SELECT id FROM competitions WHERE slug = ? LIMIT 1');
        $stmt->execute([$lc['competition_slug']]);
        $comp = $stmt->fetch(PDO::FETCH_ASSOC);
        if (!$comp) {
            $pdo->prepare(
                'INSERT INTO competitions (slug, name, description, status, created_at) VALUES (?, ?, ?, ?, ?)'
            )->execute([$lc['competition_slug'], $lc['name'], 'Domestic league fixtures', 'active', $now]);
            $compId = (int) $pdo->lastInsertId();
        } else {
            $compId = (int) $comp['id'];
        }

        foreach ($lc['fixtures'] ?? [] as $f) {
            $kickoff = $f['kickoff'];
            if (str_starts_with($kickoff, 'DYNAMIC_TODAY_')) {
                $hour = (int) substr($kickoff, 14);
                $kickoff = date('Y-m-d') . sprintf(' %02d:00:00', $hour);
            } elseif ($kickoff === 'DYNAMIC_YESTERDAY') {
                $kickoff = date('Y-m-d H:i:s', strtotime('-1 day 16:00:00'));
            }

            $check = $pdo->prepare(
                'SELECT id FROM fixtures WHERE competition_id = ? AND home_team = ? AND away_team = ? LIMIT 1'
            );
            $check->execute([$compId, $f['home'], $f['away']]);
            if ($check->fetch()) {
                continue;
            }

            $cols = ['competition_id', 'home_team', 'away_team', 'kickoff_at', 'status', 'home_score', 'away_score', 'stage', 'created_at'];
            $vals = [$compId, $f['home'], $f['away'], $kickoff, $f['status'] ?? 'scheduled', $f['home_score'] ?? null, $f['away_score'] ?? null, $f['stage'] ?? null, $now];
            if (columnExists($pdo, 'fixtures', 'competition_name', $isSqlite)) {
                $cols[] = 'competition_name';
                $vals[] = $lc['name'];
            }
            if (columnExists($pdo, 'fixtures', 'venue', $isSqlite) && !empty($f['venue'])) {
                $cols[] = 'venue';
                $vals[] = $f['venue'];
            }
            if (columnExists($pdo, 'fixtures', 'sport', $isSqlite)) {
                $cols[] = 'sport';
                $vals[] = 'football';
            }
            $ph = implode(',', array_fill(0, count($vals), '?'));
            $pdo->prepare('INSERT INTO fixtures (' . implode(',', $cols) . ') VALUES (' . $ph . ')')->execute($vals);
        }
    }

    // H2H historical fixtures
    foreach ($seed['h2h_fixtures'] ?? [] as $f) {
        $compSlug = $f['competition_slug'] ?? 'ucl-2025-26';
        $stmt = $pdo->prepare('SELECT id, name FROM competitions WHERE slug = ? LIMIT 1');
        $stmt->execute([$compSlug]);
        $comp = $stmt->fetch(PDO::FETCH_ASSOC);
        if (!$comp) {
            continue;
        }
        $compId = (int) $comp['id'];
        $check = $pdo->prepare(
            'SELECT id FROM fixtures WHERE competition_id = ? AND home_team = ? AND away_team = ? AND kickoff_at = ? LIMIT 1'
        );
        $check->execute([$compId, $f['home'], $f['away'], $f['kickoff']]);
        if ($check->fetch()) {
            continue;
        }
        $cols = ['competition_id', 'home_team', 'away_team', 'kickoff_at', 'status', 'home_score', 'away_score', 'stage', 'created_at'];
        $vals = [$compId, $f['home'], $f['away'], $f['kickoff'], $f['status'], $f['home_score'], $f['away_score'], $f['stage'] ?? null, $now];
        if (columnExists($pdo, 'fixtures', 'competition_name', $isSqlite)) {
            $cols[] = 'competition_name';
            $vals[] = $comp['name'];
        }
        $ph = implode(',', array_fill(0, count($vals), '?'));
        $pdo->prepare('INSERT INTO fixtures (' . implode(',', $cols) . ') VALUES (' . $ph . ')')->execute($vals);
    }

    // Fixture enrichment (lineups, stats)
    foreach ($seed['fixture_enrichment'] ?? [] as $key => $data) {
        [$home, $away] = explode('|', $key, 2);
        $sets = [];
        $params = [];
        if (columnExists($pdo, 'fixtures', 'lineups', $isSqlite) && !empty($data['lineups'])) {
            $sets[] = 'lineups = ?';
            $params[] = json_encode($data['lineups']);
        }
        if (columnExists($pdo, 'fixtures', 'match_stats', $isSqlite) && !empty($data['match_stats'])) {
            $sets[] = 'match_stats = ?';
            $params[] = json_encode($data['match_stats']);
        }
        if (empty($sets)) {
            continue;
        }
        $params[] = $home;
        $params[] = $away;
        $pdo->prepare(
            'UPDATE fixtures SET ' . implode(', ', $sets) . ' WHERE home_team = ? AND away_team = ?'
        )->execute($params);
    }

    // TV broadcasts from today's fixtures
    if (tableExists($pdo, 'tv_broadcasts')) {
        $channels = ['beIN Sports 1', 'beIN Sports 2', 'Sky Sports', 'ESPN', 'DAZN', 'BBC One'];
        $allFixtures = $pdo->query('SELECT f.id, f.home_team, f.away_team, f.kickoff_at, f.competition_name FROM fixtures f ORDER BY f.kickoff_at DESC LIMIT 50')->fetchAll(PDO::FETCH_ASSOC);
        $today = date('Y-m-d');
        $i = 0;
        foreach ($allFixtures as $fx) {
            if (date('Y-m-d', strtotime($fx['kickoff_at'])) !== $today) {
                continue;
            }
            $label = $fx['home_team'] . ' vs ' . $fx['away_team'];
            $stmt = $pdo->prepare('SELECT id FROM tv_broadcasts WHERE match_label = ? AND DATE(kickoff_at) = ? LIMIT 1');
            $stmt->execute([$label, $today]);
            if ($stmt->fetch()) {
                continue;
            }
            $pdo->prepare(
                'INSERT INTO tv_broadcasts (fixture_id, match_label, competition_name, channel, kickoff_at, sport, created_at)
                 VALUES (?, ?, ?, ?, ?, ?, ?)'
            )->execute([
                $fx['id'], $label, $fx['competition_name'] ?? 'Football',
                $channels[$i % count($channels)], $fx['kickoff_at'], 'football', $now,
            ]);
            $i++;
        }
        if ($i > 0) {
            ok("synced tv_broadcasts: {$i} broadcast(s)");
        }
    }

    ok('synced kooora seed');
}

