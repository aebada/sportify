function syncFanChatDemoMessages(PDO $pdo, array $demoByTeam): int
{
    if (!tableExists($pdo, 'chat_group_messages') || $demoByTeam === []) {
        return 0;
    }

    $userCache = [];
    $added = 0;
    $now = date('Y-m-d H:i:s');

    foreach ($demoByTeam as $teamSlug => $rooms) {
        foreach ($rooms as $roomKey => $messages) {
            $type = match ($roomKey) {
                'matchday'  => 'fan_matchday',
                'transfers' => 'fan_transfer',
                default     => 'fan_general',
            };

            $gstmt = $pdo->prepare('SELECT id FROM chat_groups WHERE team_slug = ? AND type = ? LIMIT 1');
            $gstmt->execute([$teamSlug, $type]);
            $groupId = (int) ($gstmt->fetchColumn() ?: 0);
            if (!$groupId) {
                continue;
            }

            $countStmt = $pdo->prepare('SELECT COUNT(*) FROM chat_group_messages WHERE group_id = ?');
            $countStmt->execute([$groupId]);
            if ((int) $countStmt->fetchColumn() > 0) {
                continue;
            }

            foreach ($messages as $msg) {
                $email = $msg['user'] ?? 'fan@test.local';
                if (!isset($userCache[$email])) {
                    $ustmt = $pdo->prepare('SELECT id FROM users WHERE email = ? LIMIT 1');
                    $ustmt->execute([$email]);
                    $userCache[$email] = (int) ($ustmt->fetchColumn() ?: 0) ?: null;
                }
                $userId = $userCache[$email];
                if (!$userId) {
                    continue;
                }

                $pdo->prepare(
                    'INSERT INTO chat_group_messages (group_id, user_id, body, created_at) VALUES (?, ?, ?, ?)'
                )->execute([$groupId, $userId, $msg['body'], $now]);
                $added++;
            }
        }
    }

    return $added;
}

