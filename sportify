/** Seed demo trainer profiles and favourite clubs (idempotent). */
function syncTrainerProfiles(PDO $pdo): void
{
    if (!tableExists($pdo, 'trainer_profiles') || !tableExists($pdo, 'users')) {
        return;
    }

    $seedFile = __DIR__ . '/database/seeds/trainer_favourite_clubs.php';
    if (!is_file($seedFile)) {
        return;
    }

    $targets = require $seedFile;
    $now = date('Y-m-d H:i:s');
    $hash = password_hash('Sportify!2026', PASSWORD_DEFAULT);
    $demoUsers = [
        ['Marco Silva', 'marco.silva@sportify.demo', 'marco-silva'],
        ['Lena Hoffmann', 'lena.hoffmann@sportify.demo', 'lena-hoffmann'],
        ['Youssef Amr', 'youssef.amr@sportify.demo', 'youssef-amr'],
        ['Sophie Martin', 'sophie.martin@sportify.demo', 'sophie-martin'],
    ];

    foreach ($demoUsers as [$name, $email, $username]) {
        $stmt = $pdo->prepare('SELECT id FROM users WHERE email = ? LIMIT 1');
        $stmt->execute([$email]);
        $uid = (int) ($stmt->fetchColumn() ?: 0);
        if (!$uid) {
            $pdo->prepare('INSERT INTO users (name, email, password, role, created_at) VALUES (?, ?, ?, ?, ?)')
                ->execute([$name, $email, $hash, 'trainer', $now]);
            $uid = (int) $pdo->lastInsertId();
        } else {
            $pdo->prepare("UPDATE users SET role = 'trainer' WHERE id = ? AND role NOT IN ('super_admin','admin')")
                ->execute([$uid]);
        }

        if (tableExists($pdo, 'member_profiles')) {
            $mp = $pdo->prepare('SELECT id FROM member_profiles WHERE user_id = ? LIMIT 1');
            $mp->execute([$uid]);
            if (!$mp->fetchColumn()) {
                $pdo->prepare('INSERT INTO member_profiles (user_id, username, headline, created_at, updated_at) VALUES (?, ?, ?, ?, ?)')
                    ->execute([$uid, $username, 'Coach · open to clubs', $now, $now]);
            }
        }

        if (!isset($targets[$email])) {
            continue;
        }
        syncTrainerProfileRow($pdo, $uid, $targets[$email], $now);
    }

    foreach ($targets as $email => $data) {
        $stmt = $pdo->prepare('SELECT id FROM users WHERE email = ? LIMIT 1');
        $stmt->execute([$email]);
        $uid = (int) ($stmt->fetchColumn() ?: 0);
        if ($uid > 0) {
            syncTrainerProfileRow($pdo, $uid, $data, $now);
        }
    }
}

/** @param array<string,mixed> $data */
function syncTrainerProfileRow(PDO $pdo, int $userId, array $data, string $now): void
{
    $check = $pdo->prepare('SELECT id FROM trainer_profiles WHERE user_id = ? LIMIT 1');
    $check->execute([$userId]);
    $specialties = json_encode($data['specialties'] ?? []);
    if (!$check->fetchColumn()) {
        $pdo->prepare(
            'INSERT INTO trainer_profiles (user_id, coaching_license, specialties, years_experience, current_club, created_at, updated_at)
             VALUES (?, ?, ?, ?, ?, ?, ?)'
        )->execute([
            $userId,
            $data['coaching_license'] ?? null,
            $specialties,
            $data['years_experience'] ?? null,
            $data['current_club'] ?? null,
            $now,
            $now,
        ]);
    } else {
        $pdo->prepare(
            'UPDATE trainer_profiles SET coaching_license = COALESCE(coaching_license, ?), specialties = COALESCE(specialties, ?),
             years_experience = COALESCE(years_experience, ?), current_club = COALESCE(current_club, ?), updated_at = ? WHERE user_id = ?'
        )->execute([
            $data['coaching_license'] ?? null,
            $specialties,
            $data['years_experience'] ?? null,
            $data['current_club'] ?? null,
            $now,
            $userId,
        ]);
    }

    if (!tableExists($pdo, 'trainer_target_clubs') || empty($data['target_clubs'])) {
        return;
    }

    $countStmt = $pdo->prepare('SELECT COUNT(*) FROM trainer_target_clubs WHERE trainer_id = ?');
    $countStmt->execute([$userId]);
    if ((int) $countStmt->fetchColumn() > 0) {
        return;
    }

    syncTrainerTargetClubRows($pdo, $userId, $data['target_clubs']);
    ok("synced trainer favourite clubs for user #{$userId}");
}

