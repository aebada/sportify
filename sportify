            "Refreshed {$newsResult['synced']} news items"
            . ($newsSources !== '' ? " ({$newsSources})" : '')
            . ", {$shortsResult['videos']} YouTube + {$shortsResult['shorts']} homepage shorts, "
            . "{$rankings['fifa']} FIFA + {$rankings['clubs']} club rankings, "
            . "{$fixtures} live fixtures from " . \App\Services\LiveFixtureFeedService::sourceLabel()
            . ($reconciled > 0 ? " (cleared {$reconciled} stale live badge(s))" : '')
            . ", OT refresh +{$otRefresh['added']} shorts."
        );
        break;
    case 'news':
        $result = \App\Services\NewsFeedService::refresh();
        $sources = implode(', ', $result['sources'] ?? []);
        $stale = !empty($result['stale']) ? ' (kept stale cache — RSS unreachable)' : '';
        ok("Refreshed {$result['synced']} football news articles → news table"
            . ($sources !== '' ? " ({$sources})" : '') . $stale);
        out('');
        out('Hostinger cron (daily 05:00 UTC):');
        out('  0 5 * * * cd /home/u234903558/domains/sportifyplus.de/public_html && /usr/bin/php sportify news >> storage/logs/news-cron.log 2>&1');
        break;
    case 'rankings':
        $rankings = \App\Services\RankingsFeedService::refresh();
        ok("Refreshed {$rankings['fifa']} FIFA teams and {$rankings['clubs']} clubs → storage/cache/rankings_feed.json");
        break;
    case 'videos':
    case 'shorts':
        $result = \App\Services\ShortsFeedService::refresh();
        $sources = implode(', ', $result['sources'] ?? []);
        ok("Refreshed {$result['videos']} YouTube RSS + {$result['shorts']} homepage shorts → shorts_feed table"
            . ($sources !== '' ? " ({$sources})" : ''));
        out('');
        out('Hostinger cron (daily 06:00 UTC):');
        out('  0 6 * * * cd /home/u234903558/domains/sportifyplus.de/public_html && /usr/bin/php sportify videos >> storage/logs/shorts-cron.log 2>&1');
        break;
    case 'feed-posts':
        $pdo = Database::connection();
        if (!$pdo) { err('No database connection.'); exit(1); }
        syncCommunityFeed($pdo);
        break;
    case 'talents':
        $pdo = Database::connection();
        if ($pdo) {
            syncOtShortsBulk($pdo);
        }
        $imported = \App\Services\TalentShortsService::refresh();
        ok("Refreshed Only Talents feed — {$imported} new shorts imported from video RSS + player catalog");
        break;
    case 'ot-seed-shorts':
        $pdo = Database::connection();
        if (!$pdo) {
            err('No database connection.');
            exit(1);
        }
        $force = in_array('--force', $argv ?? [], true);
        $result = syncOtShortsBulk($pdo, $force);
        if (!empty($result['skipped'])) {
            $existing = (int) ($result['existing'] ?? 0);
            $min = (int) ($result['min_total'] ?? 500);
            ok("OT shorts bulk seed skipped — {$existing} shorts already (min {$min})");
        } else {
            ok('OT shorts bulk seed — ' . ($result['inserted'] ?? 0) . ' inserted, '
                . ($result['total'] ?? 0) . ' total across ' . count($result['categories'] ?? []) . ' categories');
        }
        break;
    case 'talent-videos':
        $result = \App\Services\TalentVideoImportService::refresh();
        ok('Imported talent videos — ' . ($result['imported'] ?? 0) . ' videos, '
            . ($result['shorts'] ?? 0) . ' shorts (' . ($result['total'] ?? 0) . ' total in talent_imported_videos)');
        break;
    case 'ot-communities':
    case 'communities':
        $pdo = Database::connection();
        if (!$pdo) { err('No database connection.'); exit(1); }
        syncOtCommunities($pdo);
        break;
    case 'ot-seed-discovery':
        $pdo = Database::connection();
        if (!$pdo) {
            err('No database connection.');
            exit(1);
        }
        $force = in_array('--force', $argv ?? [], true);
        $result = \App\Services\OtDiscoveryProfilesSeedService::sync($force);
        ok('OT discovery profiles — ' . ($result['upserted'] ?? 0) . ' upserted across '
            . count($result['categories'] ?? []) . ' categories');
        break;
    case 'news-translate-ar':
        $limit = 100;
        $force = in_array('--force', $argv ?? [], true);
        foreach ($argv ?? [] as $arg) {
            if (str_starts_with($arg, '--limit=')) {
                $limit = max(1, (int) substr($arg, 8));
            }
        }
        Lang::set('ar');
        $result = \App\Services\NewsTranslationService::translateAll($limit, !$force);
        if (!empty($result['message'])) {
            err($result['message']);
            exit(1);
        }
        ok('Arabic news DB translation — translated ' . ($result['translated'] ?? 0)
            . ', skipped ' . ($result['skipped'] ?? 0)
            . ', errors ' . ($result['errors'] ?? 0)
            . ', batch ' . ($result['total'] ?? 0)
            . ($force ? ' (force re-translate)' : ''));
        out('');
        out('Hostinger cron (after daily news sync):');
        out('  15 5 * * * cd /home/u234903558/domains/sportifyplus.de/public_html && /usr/bin/php sportify news-translate-ar --limit=120 >> storage/logs/news-translate-ar.log 2>&1');
        break;
    case 'translate-content':
        $limit = 100;
        $batch = in_array('--batch', $argv ?? [], true);
        $locale = 'ar';
        foreach ($argv ?? [] as $arg) {
            if (str_starts_with($arg, '--limit=')) {
                $limit = max(1, (int) substr($arg, 8));
            } elseif (str_starts_with($arg, '--locale=')) {
                $locale = substr($arg, 9);
            }
        }
        Lang::set($locale);
        $result = \App\Services\ContentLocalizer::warmBatch($locale, $limit, $batch);
        ok('Content translation cache — warmed ' . ($result['translated'] ?? 0)
            . ' / ' . ($result['total'] ?? 0)
            . ($batch ? ' (batch mode)' : ''));
        out('');
        out('Hostinger cron (optional weekly warm):');
        out('  0 4 * * 0 cd /home/u234903558/domains/sportifyplus.de/public_html && /usr/bin/php sportify translate-content --locale=ar --batch --limit=200 >> storage/logs/translate-cron.log 2>&1');
        break;
    case 'seed-partners':
        $pdo = Database::connection();
        if (!$pdo) {
            err('Could not connect to the database. Check your .env settings.');
            exit(1);
        }
        \App\Models\PartnerLeadRepository::ensureSchema();
        $result = \App\Services\PartnerSeedImporter::import();
        ok('partners seeded — upserted ' . ($result['upserted'] ?? 0)
            . ' from ' . ($result['files'] ?? 0) . ' file(s)');
        foreach (($result['by_type'] ?? []) as $type => $count) {
            out('  · ' . $type . ': ' . $count);
        }
        out('  with_email=' . ($result['with_email'] ?? 0) . ' verified=' . ($result['verified'] ?? 0));
        out('Admin: /admin/partners');
        break;
    case 'invite-partners':
        $dry = in_array('--dry-run', $argv ?? [], true);
        $send = in_array('--send', $argv ?? [], true);
        $limit = 50;
        foreach ($argv ?? [] as $arg) {
            if (str_starts_with($arg, '--limit=')) {
                $limit = max(1, (int) substr($arg, 8));
            }
        }
        $result = \App\Services\PartnerInviteService::inviteAll([
            'dry_run' => $dry,
            'send' => $send,
            'verified_only' => true,
            'limit' => $limit,
        ]);
        ok('partner invite — sent=' . $result['sent'] . ' queued=' . $result['queued']
            . ' skipped=' . $result['skipped'] . ' failed=' . $result['failed']
            . ' from=' . $result['from']
            . ($dry ? ' (dry-run)' : ''));
        if (!$result['mail_configured'] && $send) {
            out('MAIL_* not configured — invites were queued instead of sent.');
        }
        break;
    default:
        out("Sportify console");
        out("  php sportify migrate   php sportify seed   php sportify fresh");
        out("  php sportify seed-partners  Import partners-*.json into partner_leads");
        out("  php sportify invite-partners [--dry-run|--send] [--limit=50]  Official partner invites");
        out("  php sportify livehd7-sync  Fetch today's matches from livehd7top.com → cache");
        out("  php sportify matches   Refresh live scores (ESPN / football-data.org)");
        out("  php sportify fixtures  Refresh live fixtures (ESPN / optional football-data.org)");
        out("  php sportify feeds     Refresh news, video, rankings + live score caches");
        out("  php sportify news      Refresh football news RSS → news table (daily cron)");
        out("  php sportify rankings  Refresh FIFA + club rankings cache");
        out("  php sportify videos    Refresh homepage shorts from YouTube RSS + talents (alias: shorts)");
        out("  php sportify shorts    Same as videos — daily homepage Shorts & Highlights refresh");
        out("  php sportify feed-posts  Seed community member feed (if < 15 posts)");
        out("  php sportify talents   Refresh Only Talents shorts from RSS + DB (runs bulk seed if < 500)");
        out("  php sportify ot-seed-shorts  Seed 500+ OT shorts (idempotent; --force to re-check keys)");
        out("  php sportify talent-videos  Import YouTube RSS into talent_imported_videos + shorts");
        out("  php sportify ot-communities  Seed demo paid/free OT communities (alias: communities)");
        out("  php sportify ot-seed-discovery  Seed discovery profiles for OT creators");
        out("  php sportify ot-prune-shorts  Mark unavailable YouTube shorts (is_available=0; --delete to remove)");
        out("  php sportify ot-refresh-shorts  Add new OT shorts from RSS + verified pool (alias: ot-daily-videos)");
        out("  php sportify news-translate-ar [--limit=100] [--force]  Store Arabic title/excerpt in news table");
        out("  php sportify translate-content [--batch] [--limit=100]  Warm Arabic content translation file cache");
        out("  php sportify admin <email> <password> [name]");
        out("  php sportify super-admin <email> <password> [name]");
        out("  php sportify user-role <email> <role>");
        out("  php sportify serve [port]");
}
