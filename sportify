#!/usr/bin/env php
<?php
/**
 * Sportify console — a tiny artisan-style CLI (no Composer needed).
 *
 *   php sportify migrate        Create database tables
 *   php sportify seed           Insert canonical content (idempotent)
 *   php sportify fresh          Migrate + seed in one go
 *   php sportify livehd7-sync   Fetch today's LiveHD7 match stream links
 *   php sportify matches        Refresh today's live match fixtures
 *   php sportify fixtures       Refresh live fixtures from ESPN / football-data.org
 *   php sportify admin <email> <password> [name]   Create/promote an admin user
 *   php sportify super-admin <email> <password> [name]   Create/promote a super admin
 *   php sportify serve [port]   Start the PHP dev server on /public
 */

$config = require __DIR__ . '/bootstrap.php';

use App\Core\Database;
use App\Core\Lang;

$argv = $_SERVER['argv'];
$cmd = $argv[1] ?? 'help';

function out(string $msg): void { fwrite(STDOUT, $msg . PHP_EOL); }
function err(string $msg): void { fwrite(STDERR, "\033[31m" . $msg . "\033[0m" . PHP_EOL); }
function ok(string $msg): void  { out("\033[32m✓\033[0m " . $msg); }

function migrate(): void
{
    $pdo = Database::connection();
    if (!$pdo) {
        err('Could not connect to the database. Check your .env settings.');
        exit(1);
    }
    $schema = require __DIR__ . '/database/schema.php';
    $isSqlite = Database::isSqlite();
    $auto = $isSqlite ? 'INTEGER PRIMARY KEY AUTOINCREMENT' : 'INT AUTO_INCREMENT PRIMARY KEY';
    $json = $isSqlite ? 'TEXT' : 'JSON';

    foreach ($schema as $table => $sql) {
        $sql = str_replace(['{{AUTO}}', '{{JSON}}'], [$auto, $json], $sql);
        $pdo->exec($sql);
        ok("migrated table: {$table}");
    }
    patchBillingSchema($pdo, $isSqlite);
    patchNewsSchema($pdo, $isSqlite);
    patchTalentShortsSchema($pdo, $isSqlite);
    patchFixturesSchema($pdo, $isSqlite);
    patchPlayersSchema($pdo, $isSqlite);
    patchScoutGdprSchema($pdo, $isSqlite);
    syncPlayerCareerTargets($pdo);
    patchTrainerSchema($pdo, $isSqlite);
    syncTrainerProfiles($pdo);
    patchMarktSchema($pdo, $isSqlite);
    patchTransferBureauSchema($pdo, $isSqlite);
    syncFitpassPlans($pdo);
    syncProviders($pdo);
    syncCompetitions($pdo);
    syncMatchHub($pdo);
    syncKoooraSeed($pdo);
    syncChatGroups($pdo);
    syncCrmDemo($pdo);
    try {
        \App\Models\PartnerLeadRepository::ensureSchema();
        $pr = \App\Services\PartnerSeedImporter::import();
        if (($pr['upserted'] ?? 0) > 0) {
            ok('synced potential partners: ' . $pr['upserted']);
        }
    } catch (\Throwable $e) {
        err('partners seed skipped: ' . $e->getMessage());
    }

    syncMarketplace($pdo);
    syncProCoaches($pdo);
    syncFansAndBookings($pdo);
    syncOnlyTalents($pdo);
    syncOtShortsBulk($pdo);
    syncTalentCategories($pdo);
    syncOtCommunities($pdo);
    syncTransferBureau($pdo);
    syncTransfermarkt($pdo);
    syncMembershipPlans($pdo);
    backfillFreeMemberships($pdo);
    backfillReferralCodes();
    syncRbacUsers($pdo);
    syncCommunityFeed($pdo);
    syncFeedShares($pdo);
    syncShortsFeed($pdo);
    syncNewsFeed($pdo);
    out('Migration complete.');
}

