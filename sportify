function indexExists(PDO $pdo, string $name, bool $isSqlite, string $table = 'players'): bool
{
    if ($isSqlite) {
        $rows = $pdo->query("PRAGMA index_list('{$table}')")->fetchAll(PDO::FETCH_ASSOC);
        foreach ($rows as $r) {
            if (($r['name'] ?? '') === $name) {
                return true;
            }
        }
        return false;
    }
    $stmt = $pdo->prepare("SHOW INDEX FROM {$table} WHERE Key_name = ?");
    $stmt->execute([$name]);
    return (bool) $stmt->fetch();
}

/** Seed demo career targets on featured catalogue players (idempotent). */
function syncPlayerCareerTargets(PDO $pdo): void
{
    if (!tableExists($pdo, 'players') || !columnExists($pdo, 'players', 'target_club', Database::isSqlite())) {
        return;
    }
    $seedFile = __DIR__ . '/database/seeds/player_career_targets.php';
    if (!is_file($seedFile)) {
        return;
    }
    $targets = require $seedFile;
    $updated = 0;
    $clubsUpdated = 0;
    $hasTargetClubs = tableExists($pdo, 'player_target_clubs');
    foreach ($targets as $slug => $t) {
        $stmt = $pdo->prepare('SELECT id, target_club, target_league, next_move_preference, next_move_notes FROM players WHERE slug = ? LIMIT 1');
        $stmt->execute([$slug]);
        $row = $stmt->fetch(PDO::FETCH_ASSOC);
        if (!$row) {
            continue;
        }
        $playerId = (int) $row['id'];

        if (empty($row['target_club'])) {
            $pdo->prepare(
                'UPDATE players SET target_club = ?, target_league = ?, next_move_preference = ?, next_move_notes = ? WHERE id = ?'
            )->execute([
                $t['target_club'] ?? null,
                $t['target_league'] ?? null,
                $t['next_move_preference'] ?? null,
                $t['next_move_notes'] ?? null,
                $playerId,
            ]);
            $updated++;
            $row = array_merge($row, [
                'target_club' => $t['target_club'] ?? null,
                'target_league' => $t['target_league'] ?? null,
                'next_move_preference' => $t['next_move_preference'] ?? null,
                'next_move_notes' => $t['next_move_notes'] ?? null,
            ]);
        }

        if (!$hasTargetClubs) {
            continue;
        }

        $countStmt = $pdo->prepare('SELECT COUNT(*) AS c FROM player_target_clubs WHERE player_id = ?');
        $countStmt->execute([$playerId]);
        $existing = (int) ($countStmt->fetch(PDO::FETCH_ASSOC)['c'] ?? 0);

        if ($existing === 0 && !empty($t['target_clubs']) && is_array($t['target_clubs'])) {
            syncPlayerTargetClubRows($pdo, $playerId, $t['target_clubs']);
            $clubsUpdated++;
            continue;
        }

        if ($existing === 0 && !empty($row['target_club'])) {
            syncPlayerTargetClubRows($pdo, $playerId, [[
                'club_name' => $row['target_club'],
                'club_slug' => null,
                'type' => 'dream',
                'note' => $row['next_move_notes'] ?? '',
            ]]);
            $clubsUpdated++;
        }
    }
    if ($updated > 0) {
        ok("synced player career targets: {$updated} player(s)");
    }
    if ($clubsUpdated > 0) {
        ok("synced player target clubs: {$clubsUpdated} player(s)");
    }
}

