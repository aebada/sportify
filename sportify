function columnExists(PDO $pdo, string $table, string $col, bool $isSqlite): bool
{
    if ($isSqlite) {
        $rows = $pdo->query("PRAGMA table_info({$table})")->fetchAll(PDO::FETCH_ASSOC);
        foreach ($rows as $r) {
            if (($r['name'] ?? '') === $col) {
                return true;
            }
        }
        return false;
    }
    $stmt = $pdo->prepare("SHOW COLUMNS FROM {$table} LIKE ?");
    $stmt->execute([$col]);
    return (bool) $stmt->fetch();
}

/** Insert any FIT-Pass plans missing from the database (safe to re-run). */
function syncFitpassPlans(PDO $pdo): void
{
    $fit = require __DIR__ . '/database/seeds/fitpass.php';
    $now = date('Y-m-d H:i:s');
    $added = 0;
    foreach ($fit['plans'] as $p) {
        $stmt = $pdo->prepare('SELECT id FROM fitpass_plans WHERE tier = ? LIMIT 1');
        $stmt->execute([$p['tier']]);
        if ($stmt->fetch()) {
            continue;
        }
        $ins = $pdo->prepare(
            'INSERT INTO fitpass_plans (name, price, period, tier, popular, tagline, features, amount_monthly, amount_yearly, currency, created_at)
             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $ins->execute([
            $p['name'], $p['price'], $p['period'], $p['tier'], !empty($p['popular']) ? 1 : 0,
            $p['tagline'], json_encode($p['features']),
            $p['amount_monthly'] ?? 0, $p['amount_yearly'] ?? 0, 'EUR', $now,
        ]);
        $added++;
    }
    if ($added > 0) {
        ok("synced fitpass_plans: {$added} new plan(s)");
    }
}

function syncProviders(PDO $pdo): void
{
    $items = require __DIR__ . '/database/seeds/providers.php';
    $now = date('Y-m-d H:i:s');
    $added = 0;
    foreach ($items as $p) {
        $stmt = $pdo->prepare('SELECT id FROM providers WHERE slug = ? LIMIT 1');
        $stmt->execute([$p['slug']]);
        if ($stmt->fetch()) {
            continue;
        }
        $ins = $pdo->prepare(
            'INSERT INTO providers (slug, type, name, tagline, description, address, city, country, country_code, phone, email, website, status, data, created_at)
             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $ins->execute([
            $p['slug'], $p['type'], $p['name'], $p['tagline'] ?? '', $p['description'] ?? '',
            $p['address'] ?? '', $p['city'] ?? '', $p['country'] ?? '', $p['country_code'] ?? '',
            $p['phone'] ?? '', $p['email'] ?? '', $p['website'] ?? '', 'active',
            json_encode($p['data'] ?? []), $now,
        ]);
        $providerId = (int) $pdo->lastInsertId();
        foreach ($p['plans'] ?? [] as $pl) {
            $pdo->prepare(
                'INSERT INTO provider_plans (provider_id, slug, name, tagline, billing_interval, amount_cents, currency, visit_credits, features, active, popular, created_at)
                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?, ?)'
            )->execute([
                $providerId, $pl['slug'], $pl['name'], $pl['tagline'] ?? '',
                $pl['billing_interval'] ?? 'monthly', $pl['amount_cents'] ?? 0, 'EUR',
                $pl['visit_credits'] ?? null, json_encode($pl['features'] ?? []),
                !empty($pl['popular']) ? 1 : 0, $now,
            ]);
        }
        $added++;
    }
    if ($added > 0) {
        ok("synced providers: {$added} new provider(s)");
    }
}

