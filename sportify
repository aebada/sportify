function patchFixturesSchema(PDO $pdo, bool $isSqlite): void
{
    $patches = [
        'fixtures' => [
            'competition_name' => 'VARCHAR(160) NULL',
            'venue'            => 'VARCHAR(160) NULL',
            'minute'           => $isSqlite ? 'INTEGER NULL' : 'INT NULL',
            'home_team_logo'   => 'VARCHAR(255) NULL',
            'away_team_logo'   => 'VARCHAR(255) NULL',
            'events'           => $isSqlite ? 'TEXT NULL' : 'JSON NULL',
            'ai_prediction'    => $isSqlite ? 'TEXT NULL' : 'JSON NULL',
            'match_type'       => "VARCHAR(20) NOT NULL DEFAULT 'competition'",
            'sport'            => "VARCHAR(20) NOT NULL DEFAULT 'football'",
            'home_team_id'     => $isSqlite ? 'INTEGER NULL' : 'INT NULL',
            'away_team_id'     => $isSqlite ? 'INTEGER NULL' : 'INT NULL',
            'lineups'          => $isSqlite ? 'TEXT NULL' : 'JSON NULL',
            'match_stats'      => $isSqlite ? 'TEXT NULL' : 'JSON NULL',
        ],
    ];
    foreach ($patches as $table => $cols) {
        foreach ($cols as $col => $def) {
            if (columnExists($pdo, $table, $col, $isSqlite)) {
                continue;
            }
            $pdo->exec("ALTER TABLE {$table} ADD COLUMN {$col} {$def}");
            ok("patched {$table}.{$col}");
        }
    }
}

