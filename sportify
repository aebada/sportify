function backfillFreeMemberships(PDO $pdo): void
{
    if (!tableExists($pdo, 'user_memberships') || !tableExists($pdo, 'membership_plans') || !tableExists($pdo, 'users')) {
        return;
    }
    $roleMap = [
        'player' => 'player', 'club' => 'club', 'scout' => 'scout', 'agent' => 'scout',
        'provider' => 'trainer', 'coach' => 'trainer', 'fan' => 'fan',
    ];
    $users = $pdo->query('SELECT id, role FROM users')->fetchAll(PDO::FETCH_ASSOC);
    $added = 0;
    foreach ($users as $u) {
        $uid = (int) $u['id'];
        $chk = $pdo->prepare(
            "SELECT id FROM user_memberships WHERE user_id = ? AND status IN ('active','trial') LIMIT 1"
        );
        $chk->execute([$uid]);
        if ($chk->fetch()) {
            continue;
        }
        $memRole = $roleMap[$u['role'] ?? 'fan'] ?? 'fan';
        $planStmt = $pdo->prepare(
            'SELECT id FROM membership_plans WHERE role = ? AND tier_level = 0 LIMIT 1'
        );
        $planStmt->execute([$memRole]);
        $planId = (int) ($planStmt->fetchColumn() ?: 0);
        if (!$planId) {
            continue;
        }
        $now = date('Y-m-d H:i:s');
        $pdo->prepare(
            'INSERT INTO user_memberships (user_id, plan_id, status, starts_at, ends_at, gateway, billing_cycle, created_at, updated_at)
             VALUES (?, ?, ?, ?, NULL, ?, ?, ?, ?)'
        )->execute([$uid, $planId, 'active', $now, 'system', 'monthly', $now, $now]);
        $added++;
    }
    if ($added > 0) {
        ok("backfilled user_memberships (free): {$added} user(s)");
    }
}

function makeAdmin(array $argv, string $role = 'admin'): void
{
    $email = $argv[2] ?? null;
    $password = $argv[3] ?? null;
    $name = $argv[4] ?? ($role === 'super_admin' ? 'Super Administrator' : 'Administrator');
    if (!$email || !$password) {
        $cmd = $role === 'super_admin' ? 'super-admin' : 'admin';
        err("Usage: php sportify {$cmd} <email> <password> [name]");
        exit(1);
    }
    $pdo = Database::connection();
    if (!$pdo) { err('No database connection.'); exit(1); }

    $existing = \App\Models\User::findByEmail($email);
    $hash = password_hash($password, PASSWORD_DEFAULT);
    if ($existing) {
        Database::execute('UPDATE users SET password = ?, role = ? WHERE id = ?', [$hash, $role, $existing['id']]);
        ok("Updated existing user to {$role}: {$email}");
    } else {
        Database::execute(
            'INSERT INTO users (name, email, password, role, created_at) VALUES (?, ?, ?, ?, ?)',
            [$name, strtolower($email), $hash, $role, date('Y-m-d H:i:s')]
        );
        ok("Created {$role} user: {$email}");
    }
}

function setUserRole(array $argv): void
{
    $email = $argv[2] ?? null;
    $role = $argv[3] ?? null;
    if (!$email || !$role) {
        err('Usage: php sportify user-role <email> <role>');
        err('Roles: ' . implode(', ', \App\Support\Rbac::allRoleKeys()));
        exit(1);
    }

    $role = \App\Support\Rbac::normalizeRole($role);
    if ($role === 'guest') {
        err('Cannot assign guest role to a user account.');
        exit(1);
    }

    $user = \App\Models\User::findByEmail($email);
    if (!$user) {
        err("User not found: {$email}");
        exit(1);
    }

    if (($user['role'] ?? '') === 'super_admin' && $role !== 'super_admin' && \App\Models\User::countSuperAdmins() <= 1) {
        err('Cannot demote the last super_admin.');
        exit(1);
    }

    \App\Models\User::updateRole((int) $user['id'], $role);
    ok("Updated {$email} → {$role}");
}

function patchMarktSchema(PDO $pdo, bool $isSqlite): void
{
    if (!tableExists($pdo, 'player_market_values')) {
        return;
    }
    $indexes = [
        'idx_pmv_player' => 'CREATE INDEX idx_pmv_player ON player_market_values(player_id)',
        'idx_tr_player' => 'CREATE INDEX idx_tr_player ON transfer_records(player_id)',
        'idx_tr_date' => 'CREATE INDEX idx_tr_date ON transfer_records(transfer_date)',
        'idx_rumour_status' => 'CREATE INDEX idx_rumour_status ON transfer_rumours(status)',
    ];
    foreach ($indexes as $name => $sql) {
        if (indexExistsGeneric($pdo, $name, $isSqlite)) {
            continue;
        }
        try {
            $pdo->exec($sql);
            ok("patched index: {$name}");
        } catch (\Throwable) {
            // index may already exist under another name
        }
    }
}

function indexExistsGeneric(PDO $pdo, string $name, bool $isSqlite): bool
{
    if ($isSqlite) {
        $rows = $pdo->query('PRAGMA index_list(player_market_values)')->fetchAll(PDO::FETCH_ASSOC);
        foreach ($rows as $r) {
            if (($r['name'] ?? '') === $name) {
                return true;
            }
        }
        return false;
    }
    $stmt = $pdo->prepare('SHOW INDEX FROM player_market_values WHERE Key_name = ?');
    $stmt->execute([$name]);
    return (bool) $stmt->fetch();
}

function syncTransfermarkt(PDO $pdo): void
{
    if (!tableExists($pdo, 'player_market_values') || !tableExists($pdo, 'players')) {
        return;
    }
    $seedFile = __DIR__ . '/database/seeds/transfermarkt.php';
    if (!is_file($seedFile)) {
        return;
    }
    $cfg = require $seedFile;
    $now = date('Y-m-d H:i:s');
    $target = (int) $cfg['player_limit'];

    $existing = (int) $pdo->query('SELECT COUNT(*) FROM players')->fetchColumn();
    if ($existing < $target) {
        $needed = $target - $existing;
        $factory = \App\Models\PlayerFactory::generate($needed + 10);
        $slugs = $pdo->query('SELECT slug FROM players')->fetchAll(PDO::FETCH_COLUMN);
        $slugSet = array_flip($slugs);
        $added = 0;
        $ins = $pdo->prepare(
            'INSERT INTO players (slug, name, number, position, position_short, age, nationality, nationality_code, foot, height, weight, club, availability, level, rating, fit, video, market_value, bio, photo, data, created_at)
             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        foreach ($factory as $p) {
            if ($added >= $needed || isset($slugSet[$p['slug']])) {
                continue;
            }
            $data = json_encode([
                'tags' => $p['tags'] ?? [], 'stats' => $p['stats'] ?? [],
                'career' => $p['career'] ?? [], 'highlights' => $p['highlights'] ?? [],
            ]);
            $ins->execute([
                $p['slug'], $p['name'], $p['number'] ?? 0, $p['position'] ?? '', $p['position_short'] ?? '',
                $p['age'] ?? 0, $p['nationality'] ?? '', $p['nationality_code'] ?? '', $p['foot'] ?? 'Right',
                $p['height'] ?? 180, $p['weight'] ?? 75, $p['club'] ?? '', $p['availability'] ?? 'Under Contract',
                $p['level'] ?? 'Semi-Pro', $p['rating'] ?? 70, $p['fit'] ?? 70, !empty($p['video']) ? 1 : 0,
                $p['market_value'] ?? '€500K', $p['bio'] ?? '', '', $data, $now,
            ]);
            $slugSet[$p['slug']] = true;
            $added++;
        }
        if ($added > 0) {
            ok("synced transfermarkt: added {$added} factory player(s) to reach market seed target");
        }
    }

    $players = $pdo->query('SELECT id, slug, name, rating, age, position_short, foot, height, nationality, club, market_value FROM players ORDER BY rating DESC LIMIT ' . $target)->fetchAll(PDO::FETCH_ASSOC);
    if (empty($players)) {
        return;
    }

    $valueCount = 0;
    $playerCount = 0;
    $agents = $cfg['agents'];
    $nationalTeams = $cfg['national_teams'];

    foreach ($players as $i => $p) {
        $playerId = (int) $p['id'];
        $rating = (int) ($p['rating'] ?? 70);
        $age = (int) ($p['age'] ?? 24);
        $youthBoost = $age <= 21 ? 1.35 : ($age <= 24 ? 1.15 : 1.0);
        $base = max(200_000, (int) round(($rating - 55) * 100_000 * $youthBoost));
        $jitter = 1 + ((abs(crc32($p['slug'] . 'tm')) % 20) - 10) / 100;
        $valueEur = (int) round($base * $jitter);
        $formatted = $valueEur >= 1_000_000
            ? '€' . rtrim(rtrim(number_format($valueEur / 1_000_000, 2, '.', ''), '0'), '.') . 'm'
            : '€' . (int) round($valueEur / 1000) . 'k';

        $foot = $p['foot'] ?? 'Right';
        $height = (int) ($p['height'] ?? 180);
        $nat = $p['nationality'] ?? '';
        $agent = $agents[$i % count($agents)];
        $nationalTeam = $nationalTeams[$nat] ?? $nat;
        $expires = $i < (int) $cfg['expiry_limit']
            ? date('Y-m-d', strtotime('+' . (20 + $i * 14) . ' days'))
            : date('Y-m-d', strtotime('+' . (400 + $i * 30) . ' days'));

        $pdo->prepare(
            'UPDATE players SET market_value_eur = ?, market_value = ?, preferred_foot = ?, height_cm = ?, contract_expires = ?, agent_name = ?, national_team = ? WHERE id = ?'
        )->execute([$valueEur, $formatted, $foot, $height, $expires, $agent, $nationalTeam, $playerId]);
        $playerCount++;

        foreach ($cfg['history_months'] as $monthsAgo) {
            $chk = $pdo->prepare('SELECT id FROM player_market_values WHERE player_id = ? AND recorded_at = ? LIMIT 1');
            $recorded = date('Y-m-d H:i:s', strtotime("-{$monthsAgo} months"));
            $chk->execute([$playerId, $recorded]);
            if ($chk->fetch()) {
                continue;
            }
            $histFactor = 1 - ($monthsAgo * 0.06);
            $histVal = (int) round($valueEur * max(0.5, $histFactor));
            $pdo->prepare(
                'INSERT INTO player_market_values (player_id, value_eur, recorded_at, created_at) VALUES (?, ?, ?, ?)'
            )->execute([$playerId, $histVal, $recorded, $now]);
            $valueCount++;
        }
    }

    $transferCount = 0;
    $types = $cfg['transfer_types'];
    $clubs = $cfg['transfer_clubs'];
    $season = '2025/26';
    foreach (array_slice($players, 0, (int) $cfg['transfer_limit']) as $i => $p) {
        $playerId = (int) $p['id'];
        $chk = $pdo->prepare('SELECT id FROM transfer_records WHERE player_id = ? AND season = ? LIMIT 1');
        $chk->execute([$playerId, $season]);
        if ($chk->fetch()) {
            continue;
        }
        $pair = $clubs[$i % count($clubs)];
        $type = $types[$i % count($types)];
        $fee = match ($type) {
            'free', 'loan' => null,
            'undisclosed' => null,
            default => (int) round(max(200_000, ($p['rating'] ?? 70) * 80_000)),
        };
        $pdo->prepare(
            'INSERT INTO transfer_records (player_id, from_club, to_club, fee_eur, type, transfer_date, season, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
        )->execute([
            $playerId,
            $pair['from'],
            $pair['to'],
            $fee,
            $type,
            date('Y-m-d', strtotime('-' . ($i * 5 + 2) . ' days')),
            $season,
            $now,
        ]);
        $transferCount++;
    }

    $rumourCount = 0;
    $sources = $cfg['rumour_sources'];
    foreach (array_slice($players, 0, (int) $cfg['rumour_limit']) as $i => $p) {
        $playerId = (int) $p['id'];
        $chk = $pdo->prepare('SELECT id FROM transfer_rumours WHERE player_id = ? LIMIT 1');
        $chk->execute([$playerId]);
        if ($chk->fetch()) {
            continue;
        }
        $pair = $clubs[($i + 2) % count($clubs)];
        $pdo->prepare(
            'INSERT INTO transfer_rumours (player_name, player_id, from_club, to_club, probability_percent, source, status, reported_at, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)'
        )->execute([
            $p['name'],
            $playerId,
            $p['club'] ?? $pair['from'],
            $pair['to'],
            30 + ($i * 4) % 65,
            $sources[$i % count($sources)],
            'active',
            date('Y-m-d H:i:s', strtotime('-' . ($i + 1) . ' days')),
            $now,
        ]);
        $rumourCount++;
    }

    ok("synced transfermarkt: {$playerCount} players, {$valueCount} value snapshots, {$transferCount} transfers, {$rumourCount} rumours");
}

function syncTalentCategories(PDO $pdo): void
{
    if (!tableExists($pdo, 'talent_categories')) {
        return;
    }
    $seedFile = __DIR__ . '/database/seeds/talent_categories.php';
    if (!is_file($seedFile)) {
        return;
    }
    $seed = require $seedFile;
    $now = date('Y-m-d H:i:s');
    $slugToId = [];

    foreach ($seed as $row) {
        $chk = $pdo->prepare('SELECT id FROM talent_categories WHERE slug = ? LIMIT 1');
        $chk->execute([$row['slug']]);
        $existing = $chk->fetchColumn();
        if ($existing) {
            $slugToId[$row['slug']] = (int) $existing;
            continue;
        }
        $ins = $pdo->prepare(
            'INSERT INTO talent_categories (slug, parent_id, name_en, name_de, name_ar, sport_type, sort_order, is_active, created_at, updated_at)
             VALUES (?, NULL, ?, ?, ?, ?, ?, 1, ?, ?)'
        );
        $ins->execute([
            $row['slug'],
            $row['name_en'],
            $row['name_de'] ?? null,
            $row['name_ar'] ?? null,
            $row['sport_type'] ?? null,
            (int) ($row['sort_order'] ?? 0),
            $now,
            $now,
        ]);
        $slugToId[$row['slug']] = (int) $pdo->lastInsertId();
    }

    foreach ($seed as $row) {
        if (empty($row['parent_slug'])) {
            continue;
        }
        $id = $slugToId[$row['slug']] ?? null;
        $parentId = $slugToId[$row['parent_slug']] ?? null;
        if ($id && $parentId) {
            $pdo->prepare('UPDATE talent_categories SET parent_id = ? WHERE id = ?')->execute([$parentId, $id]);
        }
    }

    ok('synced talent_categories: ' . count($seed) . ' rows');
}

function syncOtCommunities(PDO $pdo): void
{
    if (!tableExists($pdo, 'ot_communities')) {
        return;
    }
    $existing = (int) $pdo->query('SELECT COUNT(*) FROM ot_communities')->fetchColumn();
    if ($existing > 0) {
        out('• ot_communities: already has ' . $existing . ' rows, skipping seed.');
        return;
    }

    $seedFile = __DIR__ . '/database/seeds/ot_communities.php';
    if (!is_file($seedFile)) {
        return;
    }

    $seed = require $seedFile;
    $created = 0;

    foreach ($seed as $row) {
        $email = (string) ($row['owner_email'] ?? '');
        $ownerStmt = $pdo->prepare('SELECT id FROM users WHERE email = ? LIMIT 1');
        $ownerStmt->execute([$email]);
        $ownerId = (int) ($ownerStmt->fetchColumn() ?: 0);
        if ($ownerId <= 0) {
            continue;
        }

        $communityId = \App\Models\CommunityRepository::create([
            'owner_user_id' => $ownerId,
            'slug'          => $row['slug'],
            'name'          => $row['name'],
            'description'   => $row['description'] ?? '',
            'type'          => $row['type'] ?? 'free',
            'category_slug' => $row['category_slug'] ?? null,
            'sport_type'    => $row['sport_type'] ?? null,
            'is_featured'   => (int) ($row['is_featured'] ?? 0),
            'status'        => $row['status'] ?? 'active',
        ]);
        if (!$communityId) {
            continue;
        }

        $memberCount = (int) ($row['member_count'] ?? 0);
        if ($memberCount > 0) {
            $pdo->prepare('UPDATE ot_communities SET member_count = ? WHERE id = ?')->execute([$memberCount, $communityId]);
        }

        \App\Models\SubscriptionPlanRepository::defaultPlans($communityId, (string) ($row['type'] ?? 'free'));

        foreach ($row['posts'] ?? [] as $post) {
            \App\Models\CommunityPostRepository::create($communityId, $ownerId, [
                'type'         => 'post',
                'title'        => $post['title'] ?? 'Post',
                'body'         => $post['body'] ?? '',
                'access_level' => $post['access_level'] ?? 'members',
            ]);
            if (!empty($post['pinned'])) {
                $pdo->prepare('UPDATE ot_community_posts SET pinned = 1 WHERE community_id = ? ORDER BY id DESC LIMIT 1')
                    ->execute([$communityId]);
            }
        }

        foreach ($row['live_sessions'] ?? [] as $session) {
            $startsAt = $session['starts_at'] ?? '+7 days';
            if (str_starts_with((string) $startsAt, '+')) {
                $startsAt = date('Y-m-d H:i:s', strtotime($startsAt));
            }
            \App\Models\LiveSessionRepository::create($communityId, $ownerId, [
                'title'       => $session['title'] ?? 'Live session',
                'starts_at'   => $startsAt,
                'platform'    => $session['platform'] ?? 'zoom',
                'meeting_url' => $session['meeting_url'] ?? null,
            ]);
        }

        foreach ($row['courses'] ?? [] as $course) {
            $courseId = \App\Models\CourseRepository::create($communityId, $ownerId, [
                'slug'                 => $course['slug'],
                'title'                => $course['title'],
                'description'          => $course['description'] ?? '',
                'access_level'         => $course['access_level'] ?? 'paid',
                'free_preview_lessons' => $course['free_preview_lessons'] ?? null,
                'published'            => true,
            ]);
            if (!$courseId) {
                continue;
            }
            foreach ($course['modules'] ?? [] as $module) {
                $moduleId = \App\Models\CourseRepository::createModule($courseId, [
                    'title'        => $module['title'] ?? 'Module',
                    'access_level' => $module['access_level'] ?? 'paid',
                ]);
                if (!$moduleId) {
                    continue;
                }
                foreach ($module['lessons'] ?? [] as $lesson) {
                    \App\Models\CourseRepository::createLesson($moduleId, [
                        'title'        => $lesson['title'] ?? 'Lesson',
                        'content_type' => $lesson['content_type'] ?? 'text',
                        'access_level' => $lesson['access_level'] ?? 'paid',
                        'body'         => $lesson['body'] ?? '',
                    ]);
                }
            }
        }

        $created++;
    }

    ok('synced ot_communities: ' . $created . ' demo communities');
}

