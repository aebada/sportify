function patchTransferBureauSchema(PDO $pdo, bool $isSqlite): void
{
    if (!tableExists($pdo, 'member_profiles')) {
        return;
    }
    $real = $isSqlite ? 'REAL NULL' : 'DOUBLE NULL';
    $int = $isSqlite ? 'INTEGER NOT NULL DEFAULT 0' : 'INT NOT NULL DEFAULT 0';
    $intNull = $isSqlite ? 'INTEGER NULL' : 'INT NULL';
    $varchar = 'VARCHAR(80) NULL';
    $patches = [
        'member_profiles' => [
            'seeking_club'            => $int,
            'city'                    => $varchar,
            'latitude'                => $real,
            'longitude'               => $real,
            'league_level'            => 'VARCHAR(60) NULL',
            'team_level_preference'   => 'VARCHAR(40) NULL',
            'club_team_name'          => 'VARCHAR(160) NULL',
            'club_team_level'         => 'VARCHAR(40) NULL',
            'club_verified'           => $int,
            'transfer_premium_plan'   => 'VARCHAR(30) NULL',
            'transfer_premium_until'  => 'DATETIME NULL',
        ],
    ];
    foreach ($patches as $table => $cols) {
        foreach ($cols as $col => $def) {
            if (columnExists($pdo, $table, $col, $isSqlite)) {
                continue;
            }
            $pdo->exec("ALTER TABLE {$table} ADD COLUMN {$col} {$def}");
            ok("patched {$table}.{$col}");
        }
    }
}

