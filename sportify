/** Seed community feed posts when the feed has fewer than 15 entries. */
function syncCommunityFeed(PDO $pdo): void
{
    if (!tableExists($pdo, 'posts') || !tableExists($pdo, 'users')) {
        return;
    }

    $seedFile = __DIR__ . '/database/seeds/community_feed.php';
    if (!is_file($seedFile)) {
        return;
    }

    $existing = (int) $pdo->query('SELECT COUNT(*) FROM posts')->fetchColumn();
    if ($existing >= 15) {
        out('• community feed: already has ' . $existing . ' posts, skipping seed.');
        return;
    }

    $data = require $seedFile;
    $now = date('Y-m-d H:i:s');
    $hash = password_hash('Sportify!2026', PASSWORD_DEFAULT);

    $userIds = [];
    foreach ($data['members'] ?? [] as $m) {
        $email = strtolower($m['email']);
        $stmt = $pdo->prepare('SELECT id FROM users WHERE email = ? LIMIT 1');
        $stmt->execute([$email]);
        $uid = (int) ($stmt->fetchColumn() ?: 0);
        if (!$uid) {
            $pdo->prepare('INSERT INTO users (name, email, password, role, created_at) VALUES (?, ?, ?, ?, ?)')
                ->execute([$m['name'], $email, $hash, $m['role'] ?? 'fan', $now]);
            $uid = (int) $pdo->lastInsertId();
        }

        if (tableExists($pdo, 'member_profiles')) {
            $stmt = $pdo->prepare('SELECT id FROM member_profiles WHERE user_id = ? LIMIT 1');
            $stmt->execute([$uid]);
            if (!$stmt->fetch()) {
                $pdo->prepare(
                    'INSERT INTO member_profiles (user_id, username, headline, social, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?)'
                )->execute([
                    $uid,
                    $m['username'],
                    $m['headline'] ?? null,
                    json_encode([]),
                    $now,
                    $now,
                ]);
            }
        }

        $userIds[$m['username']] = $uid;
    }

    $insert = $pdo->prepare(
        'INSERT INTO posts (user_id, body, media_type, media_path, video_url, created_at) VALUES (?, ?, ?, ?, ?, ?)'
    );

    $added = 0;
    foreach ($data['posts'] ?? [] as $post) {
        $username = $post['author'] ?? '';
        $userId = $userIds[$username] ?? 0;
        if (!$userId) {
            continue;
        }

        $body = trim((string) ($post['body'] ?? ''));
        $videoUrl = trim((string) ($post['video_url'] ?? ''));
        $imageUrl = trim((string) ($post['image_url'] ?? ''));
        $daysAgo = (int) ($post['days_ago'] ?? 0);
        $createdAt = date('Y-m-d H:i:s', strtotime("-{$daysAgo} days"));

        $mediaType = 'none';
        $mediaPath = null;
        if ($imageUrl !== '') {
            $mediaType = 'image';
            $mediaPath = $imageUrl;
        } elseif ($videoUrl !== '') {
            $mediaType = 'video';
        }

        if ($body === '' && !$mediaPath && $videoUrl === '') {
            continue;
        }

        $insert->execute([$userId, $body, $mediaType, $mediaPath, $videoUrl ?: null, $createdAt]);
        $added++;
    }

    if ($added > 0) {
        ok("seeded community feed: {$added} posts from " . count($userIds) . ' members');
    }

    syncFeedSharesFromSeed($pdo, $data, $userIds);
}

/** Seed feed_shares from community_feed.php when table is sparse. */
function syncFeedShares(PDO $pdo): void
{
    if (!tableExists($pdo, 'feed_shares') || !tableExists($pdo, 'users')) {
        return;
    }

    $existing = (int) $pdo->query('SELECT COUNT(*) FROM feed_shares')->fetchColumn();
    if ($existing >= 3) {
        out('• feed shares: already has ' . $existing . ' entries, skipping seed.');
        return;
    }

    $seedFile = __DIR__ . '/database/seeds/community_feed.php';
    if (!is_file($seedFile)) {
        return;
    }

    $data = require $seedFile;
    $userIds = [];
    foreach ($data['members'] ?? [] as $m) {
        $email = strtolower($m['email']);
        $stmt = $pdo->prepare('SELECT id FROM users WHERE email = ? LIMIT 1');
        $stmt->execute([$email]);
        $uid = (int) ($stmt->fetchColumn() ?: 0);
        if ($uid) {
            $userIds[$m['username']] = $uid;
        }
    }

    syncFeedSharesFromSeed($pdo, $data, $userIds);
}

/** @param array<string,int> $userIds */
function syncFeedSharesFromSeed(PDO $pdo, array $data, array $userIds): void
{
    if (!tableExists($pdo, 'feed_shares') || empty($data['shares'])) {
        return;
    }

    $insert = $pdo->prepare(
        'INSERT INTO feed_shares (user_id, share_type, target_id, target_url, title, excerpt, thumbnail, comment, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)'
    );

    $postLookup = $pdo->prepare(
        'SELECT p.id FROM posts p
         JOIN member_profiles mp ON mp.user_id = p.user_id
         WHERE mp.username = ? ORDER BY p.created_at DESC LIMIT 1'
    );

    $fixtureLookup = $pdo->prepare(
        "SELECT id FROM fixtures WHERE status = 'finished' ORDER BY kickoff_at DESC LIMIT 1"
    );
    $fixtureId = 0;
    if (tableExists($pdo, 'fixtures')) {
        $fixtureLookup->execute();
        $fixtureId = (int) ($fixtureLookup->fetchColumn() ?: 0);
    }

    $added = 0;
    foreach ($data['shares'] as $share) {
        $username = $share['author'] ?? '';
        $userId = $userIds[$username] ?? 0;
        if (!$userId) {
            continue;
        }

        $shareType = (string) ($share['share_type'] ?? 'article');
        $daysAgo = (int) ($share['days_ago'] ?? 0);
        $createdAt = date('Y-m-d H:i:s', strtotime("-{$daysAgo} days"));

        $targetId = null;
        if ($shareType === 'post' && !empty($share['target_post_author'])) {
            $postLookup->execute([$share['target_post_author']]);
            $targetId = (int) ($postLookup->fetchColumn() ?: 0) ?: null;
        } elseif ($shareType === 'match' && $fixtureId > 0) {
            $targetId = $fixtureId;
        }

        $insert->execute([
            $userId,
            $shareType,
            $targetId,
            $share['target_url'] ?? null,
            $share['title'] ?? null,
            $share['excerpt'] ?? null,
            $share['thumbnail'] ?? null,
            $share['comment'] ?? null,
            $createdAt,
        ]);
        $added++;
    }

    if ($added > 0) {
        ok("seeded feed shares: {$added} shared items");
    }
}

function tableExists(PDO $pdo, string $table): bool
{
    if (Database::isSqlite()) {
        $stmt = $pdo->prepare("SELECT name FROM sqlite_master WHERE type='table' AND name=?");
        $stmt->execute([$table]);
        return (bool) $stmt->fetch();
    }
    $stmt = $pdo->prepare('SHOW TABLES LIKE ?');
    $stmt->execute([$table]);
    return (bool) $stmt->fetch();
}

function patchTalentShortsSchema(PDO $pdo, bool $isSqlite): void
{
    if (!tableExists($pdo, 'talent_shorts')) {
        return;
    }
    $patches = [
        'talent_shorts' => [
            'category_slug' => 'VARCHAR(80) NULL',
            'tags'          => 'VARCHAR(255) NULL',
            'is_available'  => $isSqlite ? 'INTEGER NULL DEFAULT 1' : 'TINYINT NULL DEFAULT 1',
        ],
    ];
    foreach ($patches as $table => $cols) {
        foreach ($cols as $col => $def) {
            if (columnExists($pdo, $table, $col, $isSqlite)) {
                continue;
            }
            $pdo->exec("ALTER TABLE {$table} ADD COLUMN {$col} {$def}");
            ok("patched {$table}.{$col}");
        }
    }
    if (!indexExists($pdo, 'idx_talent_shorts_category', $isSqlite, 'talent_shorts')) {
        $pdo->exec('CREATE INDEX idx_talent_shorts_category ON talent_shorts(category_slug)');
        ok('patched talent_shorts.idx_talent_shorts_category');
    }
}

