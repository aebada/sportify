function syncOnlyTalents(PDO $pdo): void
{
    if (!tableExists($pdo, 'talent_creator_profiles') || !tableExists($pdo, 'talent_shorts')) {
        return;
    }
    $seedFile = __DIR__ . '/database/seeds/only_talents.php';
    if (!is_file($seedFile)) {
        return;
    }
    $data = require $seedFile;
    $now = date('Y-m-d H:i:s');
    $creatorIds = [];
    $shortCount = 0;

    foreach ($data['creators'] as $c) {
        $pStmt = $pdo->prepare('SELECT id, bio FROM players WHERE slug = ? LIMIT 1');
        $pStmt->execute([$c['player_slug']]);
        $player = $pStmt->fetch(PDO::FETCH_ASSOC);
        if (!$player) {
            continue;
        }
        $playerId = (int) $player['id'];
        $chk = $pdo->prepare('SELECT id FROM talent_creator_profiles WHERE player_id = ? LIMIT 1');
        $chk->execute([$playerId]);
        $existing = (int) ($chk->fetchColumn() ?: 0);
        if ($existing) {
            $creatorIds[$c['player_slug']] = $existing;
            continue;
        }
        $pdo->prepare(
            'INSERT INTO talent_creator_profiles (player_id, user_id, slug, bio, subscription_price_cents, currency, subscriber_count, verified, is_active, created_at, updated_at)
             VALUES (?, NULL, ?, ?, ?, ?, ?, ?, 1, ?, ?)'
        )->execute([
            $playerId,
            $c['player_slug'],
            $player['bio'] ?? null,
            (int) ($c['price'] ?? 499),
            'EUR',
            (int) ($c['subscribers'] ?? 0),
            !empty($c['verified']) ? 1 : 0,
            $now,
            $now,
        ]);
        $creatorIds[$c['player_slug']] = (int) $pdo->lastInsertId();
    }

    $ytPool = $data['youtube_pool'] ?? [];
    $templates = $data['short_templates'] ?? [];
    $thumbs = $data['fallback_thumbs'] ?? [];
    $ti = 0;

    foreach ($data['creators'] as $c) {
        $creatorId = $creatorIds[$c['player_slug']] ?? null;
        if (!$creatorId) {
            continue;
        }
        $pStmt = $pdo->prepare('SELECT id FROM players WHERE slug = ? LIMIT 1');
        $pStmt->execute([$c['player_slug']]);
        $playerId = (int) ($pStmt->fetchColumn() ?: 0);

        foreach ($templates as $tpl) {
            $ytId = $ytPool[$ti % max(1, count($ytPool))] ?? 'ugmYIOZW3as';
            $source = $tpl['source'] ?? 'youtube';
            $key = 'seed:' . $c['player_slug'] . ':' . $ti;
            $chk = $pdo->prepare('SELECT id FROM talent_shorts WHERE external_key = ? LIMIT 1');
            $chk->execute([$key]);
            if ($chk->fetch()) {
                $ti++;
                continue;
            }
            $thumb = $source === 'youtube'
                ? 'https://img.youtube.com/vi/' . $ytId . '/hqdefault.jpg'
                : ($thumbs[$ti % max(1, count($thumbs))] ?? '');
            $pdo->prepare(
                'INSERT INTO talent_shorts (player_id, creator_profile_id, title, caption, video_url, embed_id, source, thumbnail, likes, views, is_premium, is_featured, external_key, created_at)
                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
            )->execute([
                $playerId,
                $creatorId,
                $tpl['title'],
                $tpl['caption'],
                $source === 'youtube' ? 'https://www.youtube.com/watch?v=' . $ytId : 'https://www.tiktok.com/@football',
                $source === 'youtube' ? $ytId : null,
                $source,
                $thumb,
                rand(80, 12000),
                rand(500, 95000),
                !empty($tpl['premium']) ? 1 : 0,
                $ti < 8 ? 1 : 0,
                $key,
                date('Y-m-d H:i:s', strtotime('-' . ($ti % 14) . ' days')),
            ]);
            $shortCount++;
            $ti++;
        }
    }

    if ($shortCount > 0 || $creatorIds) {
        ok('synced only talents: ' . count($creatorIds) . ' creators, ' . $shortCount . ' new shorts');
    }

    try {
        $imported = \App\Services\TalentShortsService::refresh();
        if ($imported > 0) {
            ok("imported {$imported} shorts from video feed");
        }
    } catch (\Throwable $e) {
        // non-fatal during migrate
    }
}

