function seedTable(string $table, array $rows, callable $map): void
{
    $pdo = Database::connection();
    $existing = (int) $pdo->query("SELECT COUNT(*) FROM {$table}")->fetchColumn();
    if ($existing > 0) {
        out("• {$table}: already has {$existing} rows, skipping.");
        return;
    }
    foreach ($rows as $row) {
        [$cols, $vals] = $map($row);
        $placeholders = implode(',', array_fill(0, count($vals), '?'));
        $colSql = implode(',', $cols);
        $stmt = $pdo->prepare("INSERT INTO {$table} ({$colSql}) VALUES ({$placeholders})");
        $stmt->execute($vals);
    }
    ok("seeded {$table}: " . count($rows) . ' rows');
}

